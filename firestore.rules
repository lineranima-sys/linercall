rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function oneWayBlocked(blocker, target) {
      return exists(/databases/$(database)/documents/socialSettings/$(blocker)/contacts/$(target))
        && get(/databases/$(database)/documents/socialSettings/$(blocker)/contacts/$(target)).data.blocked == true;
    }
    function eitherBlocked(a,b) { return oneWayBlocked(a,b) || oneWayBlocked(b,a); }
    match /socialSettings/{ownerUid}/contacts/{otherUid} {
      allow read: if signedIn() && request.auth.uid == ownerUid;
      allow create, update: if signedIn() && request.auth.uid == ownerUid && ownerUid != otherUid
        && request.resource.data.keys().hasOnly(['nickname','muted','blocked','displayName','updatedAt'])
        && request.resource.data.keys().hasAll(['nickname','muted','blocked','displayName','updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.muted is bool && request.resource.data.blocked is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == ownerUid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName','wins','losses','createdAt','lastSeen'])
        && request.resource.data.keys().hasOnly(['displayName','wins','losses','createdAt','lastSeen'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 60
        && request.resource.data.wins == 0 && request.resource.data.losses == 0
        && request.resource.data.createdAt == request.time && request.resource.data.lastSeen == request.time;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','lastSeen','activity','activityLabel','avatarData','photoURL','bannerStyle'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) || (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 60))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeen']) || request.resource.data.lastSeen == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['activity']) || request.resource.data.activity in ['browsing','chat','voice','friends','playing','watching','shopping','private_chat'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['activityLabel']) || (request.resource.data.activityLabel is string && request.resource.data.activityLabel.size() <= 80))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarData']) ||
           (request.resource.data.avatarData is string && request.resource.data.avatarData.size() <= 900000
            && request.resource.data.avatarData.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$')))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL']) ||
           (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
            && request.resource.data.photoURL.matches('^https://.*$')))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bannerStyle']) ||
           (request.resource.data.bannerStyle is int && request.resource.data.bannerStyle >= 0
            && request.resource.data.bannerStyle <= 3));
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasAll(['uid','displayName','text','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','displayName','text','createdAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.displayName is string
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /challenges/{challengeId} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.keys().hasAll(['fromUid','fromName','toUid','toName','status','createdAt'])
        && request.resource.data.keys().hasOnly(['fromUid','fromName','toUid','toName','status','createdAt'])
        && request.resource.data.fromUid == request.auth.uid && request.resource.data.toUid is string && request.resource.data.toUid != request.auth.uid
        && !eitherBlocked(request.auth.uid,request.resource.data.toUid)
        && request.resource.data.fromName is string && request.resource.data.toName is string
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.keys().hasAll(['fromUid','fromName','toUid','toName','status','createdAt'])
        && request.resource.data.keys().hasOnly(['fromUid','fromName','toUid','toName','status','createdAt'])
        && request.resource.data.fromUid == request.auth.uid && request.resource.data.toUid is string && request.resource.data.toUid != request.auth.uid
        && !eitherBlocked(request.auth.uid,request.resource.data.toUid)
        && request.resource.data.fromName is string && request.resource.data.toName is string
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.toUid == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted','rejected'];
      allow delete: if false;
    }

    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if signedIn() && request.resource.data.keys().hasAll(['uids','names','requestId','createdAt'])
        && request.resource.data.keys().hasOnly(['uids','names','requestId','createdAt'])
        && request.resource.data.uids is list && request.resource.data.uids.size() == 2
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && request.auth.uid in request.resource.data.uids
        && !eitherBlocked(request.resource.data.uids[0],request.resource.data.uids[1])
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == request.auth.uid
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid in request.resource.data.uids
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending';
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.uids;
    }

    match /conversations/{pairId}/messages/{messageId} {
      function isFriend() {
        return signedIn() && exists(/databases/$(database)/documents/friendships/$(pairId))
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pairId)).data.uids
          && !eitherBlocked(
            get(/databases/$(database)/documents/friendships/$(pairId)).data.uids[0],
            get(/databases/$(database)/documents/friendships/$(pairId)).data.uids[1]);
      }
      allow read: if isFriend();
      allow create: if isFriend() && request.resource.data.keys().hasAll(['uid','displayName','text','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','displayName','text','createdAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.displayName is string
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Pokémon Online: somente dois participantes; turnos registrados em transações.
    // Os clientes NÃO podem conceder moedas nem editar o ranking com essas partidas.
    match /pokemonMatches/{matchId} {
      function participant() {
        return signedIn() && (resource.data.hostUid == request.auth.uid
          || resource.data.guestUid == request.auth.uid);
      }
      function validTeam(team) {
        return team is list && team.size() == 3
          && team.hasOnly(['pikachu','charizard','blastoise','venusaur','gengar','lucario','eevee','snorlax'])
          && team[0] != team[1] && team[0] != team[2] && team[1] != team[2];
      }
      allow read: if participant();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'hostUid','guestUid','hostName','guestName','hostTeam','guestTeam',
          'status','turnUid','turnNo','lastTurnId','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'hostUid','guestUid','hostName','guestName','hostTeam','guestTeam',
          'status','turnUid','turnNo','lastTurnId','createdAt','updatedAt'
        ])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid is string
        && request.resource.data.guestUid != request.auth.uid
        && !eitherBlocked(request.auth.uid,request.resource.data.guestUid)
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() <= 60
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() <= 60
        && validTeam(request.resource.data.hostTeam)
        && request.resource.data.guestTeam == []
        && request.resource.data.status == 'invited'
        && request.resource.data.turnUid == ''
        && request.resource.data.turnNo == 0
        && request.resource.data.lastTurnId == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if participant() && (
        // Apenas o convidado pode aceitar ou recusar o desafio.
        (resource.data.status == 'invited'
          && request.auth.uid == resource.data.guestUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status','guestTeam','turnUid','updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            (request.resource.data.status == 'declined'
              && request.resource.data.guestTeam == resource.data.guestTeam
              && request.resource.data.turnUid == resource.data.turnUid)
            ||
            (request.resource.data.status == 'active'
              && validTeam(request.resource.data.guestTeam)
              && request.resource.data.turnUid == resource.data.hostUid)
          ))
        ||
        // Cada turno requer uma ação no mesmo commit/transação.
        (resource.data.status == 'active'
          && request.resource.data.status == 'active'
          && request.auth.uid == resource.data.turnUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['turnUid','turnNo','lastTurnId','updatedAt'])
          && request.resource.data.turnNo == resource.data.turnNo + 1
          && request.resource.data.turnNo <= 300
          && request.resource.data.turnUid ==
             (request.auth.uid == resource.data.hostUid
               ? resource.data.guestUid : resource.data.hostUid)
          && request.resource.data.lastTurnId is string
          && request.resource.data.lastTurnId != resource.data.lastTurnId
          && request.resource.data.updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/pokemonMatches/$(matchId)/turns/$(request.resource.data.lastTurnId))
          && getAfter(/databases/$(database)/documents/pokemonMatches/$(matchId)/turns/$(request.resource.data.lastTurnId)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/pokemonMatches/$(matchId)/turns/$(request.resource.data.lastTurnId)).data.turnNo == request.resource.data.turnNo)
      );
      allow delete: if false;

      match /turns/{turnId} {
        function room() {
          return get(/databases/$(database)/documents/pokemonMatches/$(matchId)).data;
        }
        function roomAfter() {
          return getAfter(/databases/$(database)/documents/pokemonMatches/$(matchId)).data;
        }
        allow read: if signedIn() && (room().hostUid == request.auth.uid
          || room().guestUid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid','turnNo','type','index','createdAt'])
          && request.resource.data.keys().hasAll(['uid','turnNo','type','index','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && room().status == 'active'
          && room().turnUid == request.auth.uid
          && request.resource.data.turnNo is int
          && request.resource.data.turnNo == room().turnNo + 1
          && request.resource.data.turnNo <= 300
          && request.resource.data.type in ['attack','rest','switch']
          && request.resource.data.index is int
          && request.resource.data.index >= 0 && request.resource.data.index <= 2
          && request.resource.data.createdAt == request.time
          && roomAfter().turnNo == request.resource.data.turnNo
          && roomAfter().lastTurnId == turnId;
        allow update, delete: if false;
      }
    }

    // Ofertas são publicadas somente pelo administrador do Firebase.
    // Usuários autenticados só enxergam ofertas ativas.
    match /weeklyRankings/{weekKey}/players/{playerId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /settledPokemonMatches/{matchId} {
      allow read, write: if false;
    }

    match /offers/{offerId} {
      allow read: if signedIn() && resource.data.active == true;
      allow create, update, delete: if false;
    }

    match /videos/{videoId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // TERMO Online: tentativas e saldo são alterados apenas pela API Firebase Admin.
    // O cliente só pode ler o placar público da competição, nunca gravar vencedores.
    match /termoDays/{day}/players/{uid} {
      allow read, write: if false;
    }
    match /termoDays/{day}/winners/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /arcadeWallets/{uid} {
      allow read, write: if false;
    }

    // SHOOT'E R! — duelo beta entre duas contas, sem recompensas de moedas.
    match /shooterRooms/{roomId} {
      function participant() {
        return signedIn() &&
          (resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid);
      }
      function validMap(m) {
        return m in ['tanjiro','folha','chaves','undefined'];
      }
      allow get: if signedIn() && (participant() || resource.data.status == 'waiting');
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['hostUid','hostName','guestUid','guestName','hostMap','guestMap','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['hostUid','hostName','guestUid','guestName','hostMap','guestMap','status','createdAt','updatedAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 40
        && request.resource.data.guestUid == '' && request.resource.data.guestName == ''
        && request.resource.data.hostMap == '' && request.resource.data.guestMap == ''
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && (
        // Um único segundo jogador entra na sala vazia.
        (resource.data.status == 'waiting' && resource.data.guestUid == ''
          && request.auth.uid != resource.data.hostUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid','guestName','status','updatedAt'])
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 40
          && request.resource.data.status == 'choosing'
          && request.resource.data.updatedAt == request.time)
        ||
        // Cada participante pode registrar apenas o próprio voto, uma vez.
        (participant() && resource.data.guestUid != '' && resource.data.status == 'choosing'
          && request.resource.data.updatedAt == request.time
          && (
            (request.auth.uid == resource.data.hostUid && resource.data.hostMap == ''
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostMap','updatedAt'])
              && validMap(request.resource.data.hostMap))
            ||
            (request.auth.uid == resource.data.guestUid && resource.data.guestMap == ''
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestMap','updatedAt'])
              && validMap(request.resource.data.guestMap))
          ))
      );
      allow delete: if false;

      match /players/{playerUid} {
        function room() {
          return get(/databases/$(database)/documents/shooterRooms/$(roomId)).data;
        }
        function participant() {
          return signedIn() &&
            (room().hostUid == request.auth.uid || room().guestUid == request.auth.uid);
        }
        function validPose(data) {
          return data.keys().hasOnly(['uid','x','y','angle','pitch','weapon','hp','updatedAt'])
            && data.keys().hasAll(['uid','x','y','angle','pitch','weapon','hp','updatedAt'])
            && data.uid == request.auth.uid
            && data.x is number && data.x >= 0 && data.x <= 32
            && data.y is number && data.y >= 0 && data.y <= 27
            && data.angle is number && data.angle >= 0 && data.angle <= 7
            && data.pitch is number && data.pitch >= -0.7 && data.pitch <= 0.7
            && data.weapon is int && data.weapon >= 0 && data.weapon <= 3
            && data.hp is number && data.hp >= 0 && data.hp <= 100
            && data.updatedAt == request.time;
        }
        allow read: if participant();
        allow create: if participant() && playerUid == request.auth.uid
          && validPose(request.resource.data);
        allow update: if participant() && playerUid == request.auth.uid
          && validPose(request.resource.data)
          && request.resource.data.uid == resource.data.uid;
        allow delete: if false;
      }
      match /shots/{shotId} {
        function room() {
          return get(/databases/$(database)/documents/shooterRooms/$(roomId)).data;
        }
        function participant() {
          return signedIn() &&
            (room().hostUid == request.auth.uid || room().guestUid == request.auth.uid);
        }
        allow read: if participant();
        allow create: if participant()
          && request.resource.data.keys().hasOnly(['uid','weapon','x','y','angle','pitch','createdAt'])
          && request.resource.data.keys().hasAll(['uid','weapon','x','y','angle','pitch','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.weapon is int && request.resource.data.weapon >= 0 && request.resource.data.weapon <= 3
          && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 32
          && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 27
          && request.resource.data.angle is number && request.resource.data.angle >= 0 && request.resource.data.angle <= 7
          && request.resource.data.pitch is number && request.resource.data.pitch >= -0.7 && request.resource.data.pitch <= 0.7
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}